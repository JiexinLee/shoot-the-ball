# ============================================================
# Shoot The Ball - AI Worker 线上部署参考环境变量
# 路径: services/ai-worker/.env.example
# 不要把真实密钥写在这个文件里！这个文件是给部署人员/CI 看变量清单用的
# ============================================================

# ---------- 环境 ----------
APP_ENV=production

# ---------- Redis 队列 ----------
# 推荐：Upstash / Redis Cloud / 自建 Docker Redis
# 选择 Upstash 时直接填 REDIS_URL 就好，host/port 可以留空
REDIS_URL=redis://default:YOUR_UPSTASH_PASSWORD@xxxxx.upstash.io:30193
# 自建 Redis 的写法（二选一）
# REDIS_HOST=10.0.0.12
# REDIS_PORT=6379
# REDIS_PASSWORD=xxxxxxxx
# REDIS_DB=0

# ---------- Node.js API 地址（VPC 内网优先，走公网要加 TOKEN）----------
API_BASE_URL=https://api.yourdomain.com/v1
API_INTERNAL_TOKEN=YOUR_SHARED_INTERNAL_SECRET

# ---------- 视频源 / 导出存储 ----------
# ❗️ 推荐方案：Cloudflare R2（S3 兼容，零出口流量费，免费额度 10GB 存储 + 每月 100 万次请求）
STORAGE_PROVIDER=s3
# R2 需要填 endpoint，官方 AWS S3 不用填
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# 原视频桶
STORAGE_BUCKET_SOURCE=shoot-the-ball-source
# 导出 clips / 集锦桶
STORAGE_BUCKET_EXPORTS=shoot-the-ball-exports

# ---------- 队列名（必须与 Node.js API 侧一致）----------
BULLMQ_PROCESSING_QUEUE=video-processing
BULLMQ_EXPORT_QUEUE=video-export
BULLMQ_CONCURRENCY=4

# ---------- Worker 模式 ----------
# 生产环境强烈建议把 processing 和 export 拆成两个 Deployment 独立扩缩容
# processing 节点：需要 GPU，贵，只跑 processing 队列
# export 节点：纯 CPU ffmpeg，便宜，可跑 export 队列
AI_WORKER_MODE=processing     # 或者 export
AI_MODEL_VERSION=0.1.0
AI_PIPELINE_VERSION=0.1.0

# ---------- 临时目录（容器里最好挂个大容量磁盘，视频处理很吃 IO）----------
AI_WORKER_TMP_DIR=/data/ai-worker

# ---------- Highlight 剪辑窗口 ----------
AI_DEFAULT_HIGHLIGHT_PRE_SECONDS=5.0
AI_DEFAULT_HIGHLIGHT_POST_SECONDS=3.0

# ---------- Pipeline ----------
AI_COARSE_FPS=2.0
AI_FINE_FPS=8.0
AI_CONFIDENCE_THRESHOLD=0.55

# ---------- DEMO 模式（生产必须关！）----------
AI_DEMO_MODE=false
