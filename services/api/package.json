{
  "name": "@shoot-the-ball/api",
  "version": "0.1.0",
  "private": true,
  "description": "Shoot The Ball - Node.js API Service",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "env:probe": "tsx --env-file=../../.env env_probe.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules",
    "db:generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio",
    "db:push": "node --env-file=../../.env ./node_modules/prisma/build/index.js db push",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.7.8",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "envalid": "^9.0.0",
    "express": "^5.3.0",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.10",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
