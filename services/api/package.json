{
  "name": "@shoot-the-ball/api",
  "version": "0.1.0",
  "private": true,
  "description": "Shoot The Ball - Node.js API Service",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env.local dist/main.js",
    "env:probe": "tsx --env-file=.env.local env_probe.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules",
    "db:generate": "node --env-file=.env.local ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file=.env.local ./node_modules/prisma/build/index.js studio",
    "db:push": "node --env-file=.env.local ./node_modules/prisma/build/index.js db push",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@prisma/client": "5.18.0",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "envalid": "^8.0.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.7",
    "pino": "^8.18.0",
    "pino-http": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.10",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "pino-pretty": "^13.1.3",
    "prisma": "5.18.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
