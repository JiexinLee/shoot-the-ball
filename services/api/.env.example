# =========================================================================
# Shoot The Ball - API 开发环境示例 env (拷贝为 .env.local 再改)
# 路径: services/api/.env.example
# =========================================================================

# ---------- 运行环境 ----------
NODE_ENV=development
APP_ENV=development

# ---------- HTTP ----------
API_HOST=127.0.0.1
API_PORT=4000
API_PREFIX=/v1
# 多域名逗号分隔；* 代表允许任意来源，仅开发环境使用
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# ---------- 认证 ----------
# 本地开发强烈建议打开 bypass，避免被 JWT 卡着联调
DEV_BYPASS_AUTH=true
DEV_FIXED_USER_ID=user_dev_000000000000001
DEV_FIXED_USER_EMAIL=dev@shoot-the-ball.local
DEV_FIXED_USER_NAME=Developer

# 生产用的 JWT（接入账号体系后再填）
JWT_SECRET=please_change_me_to_a_long_random_string_min_32_bytes
JWT_EXPIRES_IN=7d

# ---------- PostgreSQL（Supabase / 本地都行）----------
# ⚠️ Prisma CLI 在 services/api/ 目录下跑 dotenv 时只读本目录 .env.local，
#    不会往上读根目录 .env.local。所以 DIRECT_DATABASE_URL 必须在这里写，
#    否则 pnpm db:push / db:seed 会报 P1012 "Environment variable not found: DIRECT_DATABASE_URL"
# DATABASE_URL      = PrismaClient 连接池 URL
# DIRECT_DATABASE_URL = prisma migrate/db:push/db:seed 直连 URL（不走连接池）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shoot_the_ball?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shoot_the_ball?schema=public

# ---------- Redis / 队列（入队 / Python Worker 消费）----------
# 二选一：推荐 REDIS_URL 直接配（Upstash 免费层很方便）
# REDIS_URL=redis://default:xxxxx@your-id.upstash.io:30193
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- S3 / R2 对象存储 ----------
# Cloudflare R2 示例（零出口费，MVP 最推荐）
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=xxxxxxxxxx
STORAGE_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxx
STORAGE_BUCKET_SOURCE=shoot-the-ball-source
STORAGE_BUCKET_EXPORTS=shoot-the-ball-exports

# 临时签名 URL 的有效期（秒）
STORAGE_PRESIGNED_UPLOAD_TTL=1800      # 手机弱网下上传 30 分钟比较稳
STORAGE_PRESIGNED_DOWNLOAD_TTL=3600

# ---------- BullMQ ----------
BULLMQ_CONCURRENCY=2
BULLMQ_PROCESSING_QUEUE=video-processing
BULLMQ_EXPORT_QUEUE=video-export

# ---------- SSE ----------
JOBS_SSE_POLL_INTERVAL_MS=1500
JOBS_SSE_MAX_CONNECTION_MS=600000

# ---------- 内部 token（Python ai-worker ↔ Node API 共享）----------
# 两边必须完全一致；长度至少 32 字节随机
API_INTERNAL_TOKEN=please_change_me_abcdef1234567890abcdef1234567890
