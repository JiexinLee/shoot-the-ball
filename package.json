{
  "name": "shoot-the-ball",
  "version": "0.1.0",
  "private": true,
  "description": "AI Basketball Highlight Generator - Monorepo",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev:dashboard": "pnpm --filter @shoot-the-ball/web run dev",
    "dev:web": "pnpm dev:dashboard",
    "build:dashboard": "pnpm --filter @shoot-the-ball/web run build",
    "build:web": "pnpm build:dashboard",
    "start:dashboard": "pnpm --filter @shoot-the-ball/web run start",
    "start:web": "pnpm start:dashboard",
    "lint:dashboard": "pnpm --filter @shoot-the-ball/web run lint",
    "typecheck:dashboard": "pnpm --filter @shoot-the-ball/web exec tsc --noEmit",
    "dev:api": "pnpm --filter @shoot-the-ball/api run dev",
    "build:api": "pnpm --filter @shoot-the-ball/api run build",
    "dev:all": "turbo run dev --filter=@shoot-the-ball/web --filter=@shoot-the-ball/api --parallel",
    "db:generate": "pnpm --filter @shoot-the-ball/api db:generate",
    "db:migrate": "pnpm --filter @shoot-the-ball/api db:migrate",
    "db:studio": "pnpm --filter @shoot-the-ball/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose pull && docker compose up -d",
    "dev:env": "cp -f .env.development.local .env.local",
    "dev:up": "pnpm run dev:env && pnpm run docker:reset && sleep 8 && pnpm --filter @shoot-the-ball/api run db:push && pnpm --filter @shoot-the-ball/api run db:seed",
    "dev:start": "turbo run dev --filter=@shoot-the-ball/api --filter=@shoot-the-ball/web --parallel"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
