# ============================================================
# Shoot The Ball · 单一配置源（统一模板，拷贝为 .env 再改）
# Monorepo Root：apps/web、services/api、services/ai-worker 全部只读这一个文件
# Hard Constraint：只有两种模式，development / production，通过 APP_ENV 一行切换
# ============================================================

# ============================================================
# ① Mode Switch · 只有两个合法值：development | production
#   development → 本地下方 Block 2 生效（Docker DB + Docker Redis + 云端 R2）
#   production  → 本地下方 Block 3 生效（Supabase Pooler + Upstash + 云端 R2）
# 切换后必须重启所有服务（API / Web / AI Worker）
# ============================================================
APP_ENV=development
NODE_ENV=development
TZ=UTC

# ============================================================
# ② Global Shared（Dev/Prod 通用，不随模式切换）
#    Cloudflare R2、API/JWT 基础、BullMQ 队列名、共享 Token 等
# ============================================================

# ----- Cloudflare R2（统一开发/生产都直接用云端 R2，避免本地 MinIO 复杂度）-----
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://<YOUR_CF_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<YOUR_R2_S3_ACCESS_KEY>
STORAGE_SECRET_ACCESS_KEY=<YOUR_R2_S3_SECRET_KEY>
STORAGE_BUCKET_SOURCE=shoot-the-ball-source
STORAGE_BUCKET_EXPORTS=shoot-the-ball-exports
STORAGE_PRESIGNED_UPLOAD_TTL=900
STORAGE_PRESIGNED_DOWNLOAD_TTL=3600

# ----- API Service Basic -----
API_HOST=0.0.0.0
API_PORT=4321
API_PREFIX=/v1
API_CORS_ORIGIN=*

# ----- JWT（开发开 DEV_BYPASS_AUTH 可以不用真的 JWT 校验）-----
JWT_SECRET=please_change_me_to_a_min_32_bytes_long_random_string
JWT_EXPIRES_IN=7d

# ----- BullMQ / Jobs -----
BULLMQ_CONCURRENCY=2
BULLMQ_PROCESSING_QUEUE=video-processing
BULLMQ_EXPORT_QUEUE=video-export
JOBS_SSE_POLL_INTERVAL_MS=1500
JOBS_SSE_MAX_CONNECTION_MS=600000

# ----- Internal Token（Node API ↔ Python AI Worker 共享，两边必须完全一致）-----
# 至少 32 字节随机；生产部署一定要换
API_INTERNAL_TOKEN=please_change_me_to_a_min_64_bytes_long_random_shared_secret

# ----- Flutter Mobile 联调用（给模拟器用 10.0.2.2 映射宿主机）-----
FLUTTER_API_BASE_URL=http://10.0.2.2:4321/v1

# ============================================================
# ③ Development Override（APP_ENV=development 时生效）
#    本地开发：DB / Redis 走 Docker compose 起的本地容器
#    注释掉本 Block 后，上方 Block 4 的 Production 配置自动生效
# ============================================================
# ---------- PostgreSQL（docker compose postgres）----------
DATABASE_URL="postgresql://shoot:shootdevpass123@127.0.0.1:5432/shoot_the_ball_dev?schema=public&sslmode=disable&connect_timeout=10"
DIRECT_DATABASE_URL="postgresql://shoot:shootdevpass123@127.0.0.1:5432/shoot_the_ball_dev?schema=public&sslmode=disable&connect_timeout=10"

# ---------- Redis（docker compose redis）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=shootredisdevpass123
REDIS_URL="redis://:shootredisdevpass123@127.0.0.1:6379/0"

# ============================================================
# ④ Production Override（APP_ENV=production 时生效，把 Block ③ 注释掉再取消本 Block 注释）
#    Supabase Pooler（交易模式连 DB，会话模式跑迁移）+ Upstash Serverless Redis
# ============================================================
# DATABASE_URL="postgresql://<user>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_DATABASE_URL="postgresql://<user>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
# REDIS_URL="rediss://default:<password>@glad-deer-295042.upstash.io:6379"
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=

# ============================================================
# ⑤ API Service Exclusive（与模式无关，永远保持填写）
# ============================================================
# 开发阶段必开 true：跳过 JWT 解析，直接用固定开发用户联调
# 生产部署强制 false（Hard Safety）
DEV_BYPASS_AUTH=true
DEV_FIXED_USER_ID=user_dev_000000000000001
DEV_FIXED_USER_EMAIL=dev@shoot-the-ball.local
DEV_FIXED_USER_NAME=Developer

# MVP 早期简化开关：绕过真实 R2 上传 + 跳过 HeadObject 校验
#   true  = 假上传 + 假校验（UI 状态机跑通先，不被 R2 CORS 卡）
#   false = 真 PUT 到 R2 预签名 URL + complete 时 headObject 校验（生产必须 false）
# 切换后需要重启 API 服务
DEV_MOCK_STORAGE=false

# MVP 早期简化开关：跳过真实 AI Worker 调度，API 本地直接造假结果
#   true（默认，推荐 MVP 早期开）=
#       POST /videos/:id/process 时直接把 ProcessingJob → READY + 自动插入 3 条假 highlights。
#       好处：
#        ① GET /jobs/:id/events 订阅时一连接就是 READY，立刻 SSE end，不会 1.5s 轮询刷爆 Prisma SELECT
#        ② GET /videos/:id/highlights 能直接看到 highlights 列表渲染，UI 全链路跑通
#        ③ 不需要启动 services/ai-worker（Python），API + Web 两个进程就够了
#   false（想接真 AI Worker 时切这里）=
#       POST /videos/:id/process 正常 enqueueProcessingJob → BullMQ → Redis → 等待 Python ai-worker 消费
#       你需要额外启动：cd services/ai-worker && (python 启动命令看 README)
# 安全：只有 APP_ENV=development 时 mock 生效；production 即便你手贱改 true 也强制走真实入队。
DEV_MOCK_PROCESSING=true

# ============================================================
# ⑥ AI Worker Exclusive（与模式无关，永远保持填写）
#    Python 端专属参数，只被 services/ai-worker 读取
# ============================================================
# 本地/内网部署时 API server 的地址（Worker PATCH jobs / POST highlights 用）
# 不要带尾部斜杠；/v1 前缀与 Block ② API_PREFIX 保持一致
API_BASE_URL=http://127.0.0.1:4321/v1

# all        = 同时监听 processing + export 两个队列（开发本机推荐）
# processing = 只跑视频推理（需要 GPU，生产节点拆分）
# export     = 只跑 ffmpeg 导出（纯 CPU，便宜）
AI_WORKER_MODE=all

AI_MODEL_VERSION=0.1.0
AI_PIPELINE_VERSION=0.1.0
AI_WORKER_TMP_DIR=/tmp/shoot-the-ball

# 精彩片段截取窗口：进球事件往前 N 秒，往后 M 秒
AI_DEFAULT_HIGHLIGHT_PRE_SECONDS=5
AI_DEFAULT_HIGHLIGHT_POST_SECONDS=3

# Stage 1 先跑通调度链路：跳过真 YOLO 推理，sleep 模拟进度
# 链路跑通 + SSE 订阅正常 → 再改 false 接真模型
AI_DEMO_MODE=true

# 推理后端：Apple Silicon 自动 MPS；Intel fallback CPU；NVIDIA 填 cuda
AI_TORCH_BACKEND=auto

# 两阶段推理 FPS：粗扫找候选帧（快）/ 精修篮球轨迹（准）
AI_COARSE_FPS=2.0
AI_FINE_FPS=8.0
AI_CONFIDENCE_THRESHOLD=0.55
