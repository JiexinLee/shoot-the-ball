# ==============================
# Global / Shared Environment
# ==============================
APP_ENV=development
TZ=UTC

# ==============================
# PostgreSQL (Neon / Local)
# ==============================
DATABASE_URL=postgresql://username:password@localhost:5432/shoot_the_ball?sslmode=disable
DIRECT_DATABASE_URL=postgresql://username:password@localhost:5432/shoot_the_ball?sslmode=disable

# ==============================
# Redis (BullMQ Queue)
# ==============================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# ==============================
# Object Storage (S3-compatible)
# ==============================
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key
STORAGE_BUCKET_SOURCE=shoot-the-ball-source
STORAGE_BUCKET_EXPORTS=shoot-the-ball-exports
STORAGE_PRESIGNED_UPLOAD_TTL=900
STORAGE_PRESIGNED_DOWNLOAD_TTL=3600

# ==============================
# Node.js API Service
# ==============================
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGIN=*
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d
API_PREFIX=/v1

# ==============================
# BullMQ / Jobs
# ==============================
BULLMQ_CONCURRENCY=2
BULLMQ_PROCESSING_QUEUE=video-processing
BULLMQ_EXPORT_QUEUE=video-export

# ==============================
# Python AI Worker
# ==============================
AI_WORKER_MODE=all
AI_MODEL_VERSION=0.1.0
AI_PIPELINE_VERSION=0.1.0
AI_WORKER_TMP_DIR=/tmp/shoot-the-ball
AI_DEFAULT_HIGHLIGHT_PRE_SECONDS=5
AI_DEFAULT_HIGHLIGHT_POST_SECONDS=3

# ==============================
# Flutter Mobile (API base URL)
# ==============================
FLUTTER_API_BASE_URL=http://10.0.2.2:4000/v1
